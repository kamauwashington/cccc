{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.pristine/**)",
      "Edit(./.pristine/**)",
      "Read(./.solution/**)",
      "Edit(./.solution/**)",
      "Read(./data/**)",
      "Edit(./data/**)"
    ],
    "allow": [
      "Bash(node tools/board.mjs:*)",
      "Bash(node tools/people.mjs:*)",
      "Bash(node tools/activity.mjs:*)",
      "Bash(npm start)",
      "Bash(npm start:*)",
      "Bash(npm run reset:*)",
      "Bash(node ../../scripts/reset.mjs:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/complete.mjs"
          }
        ]
      }
    ]
  }
}
