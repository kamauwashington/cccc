{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.pristine/**)",
      "Edit(./.pristine/**)",
      "Read(./.solution/**)",
      "Edit(./.solution/**)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run reset:*)",
      "Bash(node ../../scripts/reset.mjs:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsx src/cli.ts:*)",
      "Bash(mkdir -p .tmp)",
      "Edit(./.tmp/**)",
      "Edit(./OUTPUT.md)",
      "Read(./fixtures/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/complete.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bash-output-guard.mjs"
          }
        ]
      }
    ]
  }
}
