{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.pristine/**)",
      "Edit(./.pristine/**)",
      "Read(./.solution/**)",
      "Edit(./.solution/**)"
    ],
    "allow": [
      "Task",
      "Read(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Edit(./src/**)",
      "Write(./src/**)",
      "Edit(./openapi/**)",
      "Write(./openapi/**)",
      "Edit(./REVIEW.md)",
      "Write(./REVIEW.md)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run sharpen)",
      "Bash(npm start)",
      "Bash(npm start:*)",
      "Bash(npm run reset:*)",
      "Bash(node ../../scripts/reset.mjs:*)",
      "Bash(node ../../scripts/solution.mjs:*)",
      "Bash(cat RESULT.md)",
      "Bash(cat REVIEW.md)",
      "Bash(cat TRANSCRIPT.md)",
      "Bash(wc -l:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/complete.mjs" }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/subagent-line.mjs" }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/subagent-line.mjs" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/bash-output-guard.mjs" }]
      }
    ]
  }
}
