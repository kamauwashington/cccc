{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run preflight)",
      "Bash(npm run lint:prose)",
      "Bash(npm run setup)",
      "Bash(npm run reset:*)"
    ],
    "deny": [
      "Read(./examples/*/.pristine/**)",
      "Edit(./examples/*/.pristine/**)"
    ]
  }
}
